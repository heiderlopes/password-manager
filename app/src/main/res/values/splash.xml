<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Define o ícone ou logotipo animado que aparece na tela splash.-->

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/logo_app
        </item>

        <!-- Define a cor de fundo da SplashScreen-->
        <item name="windowSplashScreenBackground">
            @color/splash_background
        </item>

        <!-- Após a SplashScreen desaparecer, esse é o tema que será aplicado automaticamente ao app.-->
        <item name="postSplashScreenTheme">
            @style/Theme.PasswordManager
        </item>
    </style>
</resources>